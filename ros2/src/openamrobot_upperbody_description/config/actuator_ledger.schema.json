{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Actuator and electrical ledger",
  "description": "Schema for config/actuator_ledger.yaml. Every quantity carries value, SI unit, source, status and owner. Null values must be status unknown or not_applicable with a note; non-null values must have a source.",
  "type": "object",
  "required": [
    "ledger_revision",
    "description",
    "actuators"
  ],
  "additionalProperties": false,
  "properties": {
    "ledger_revision": {
      "type": "integer",
      "minimum": 1
    },
    "description": {
      "type": "string"
    },
    "actuators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/actuator"
      }
    }
  },
  "$defs": {
    "unit": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "1",
            "m",
            "s",
            "rad",
            "rad/s",
            "rad/s^2",
            "m/s",
            "m/s^2",
            "N",
            "N*m",
            "N*m/rad",
            "N*m*s/rad",
            "N*s/m",
            "A",
            "V",
            "F",
            "kg",
            "kg*m^2",
            "bit/s",
            "Hz"
          ]
        }
      ]
    },
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit",
        "source",
        "status",
        "owner"
      ],
      "properties": {
        "value": {
          "type": [
            "number",
            "string",
            "boolean",
            "null"
          ]
        },
        "unit": {
          "$ref": "#/$defs/unit"
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "datasheet",
            "supplier_confirmation",
            "upstream_config",
            "upstream_urdf",
            "cad",
            "measured",
            "estimated",
            "proposed",
            "decision",
            "unknown",
            "not_applicable"
          ]
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string"
        }
      },
      "oneOf": [
        {
          "type": "object",
          "required": [
            "value",
            "unit",
            "source",
            "status",
            "owner"
          ],
          "properties": {
            "value": {
              "type": [
                "number",
                "string",
                "boolean"
              ]
            },
            "source": {
              "type": "string",
              "minLength": 3
            },
            "status": {
              "enum": [
                "datasheet",
                "supplier_confirmation",
                "upstream_config",
                "upstream_urdf",
                "cad",
                "measured",
                "estimated",
                "proposed",
                "decision"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "value",
            "unit",
            "source",
            "status",
            "owner",
            "note"
          ],
          "properties": {
            "value": {
              "type": "null"
            },
            "source": {
              "type": "null"
            },
            "status": {
              "enum": [
                "unknown",
                "not_applicable"
              ]
            },
            "note": {
              "type": "string",
              "minLength": 3
            }
          }
        }
      ]
    },
    "actuator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "description",
        "urdf_joint",
        "part",
        "revision",
        "bus",
        "node_id",
        "bitrate",
        "control_mode",
        "gear_ratio",
        "rated_speed",
        "max_speed",
        "rated_current",
        "peak_current",
        "rated_voltage",
        "supply_bus_voltage_nominal",
        "supply_bus_voltage_max",
        "brake_present",
        "brake_holding_torque",
        "brake_release_time",
        "brake_engage_time",
        "brake_coil_voltage",
        "rotor_inertia",
        "joint_damping",
        "joint_friction",
        "heartbeat_period",
        "comm_timeout",
        "extra"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "kind": {
          "enum": [
            "hub_motor",
            "motor_driver",
            "linear_actuator",
            "actuator_controller",
            "bus_node",
            "joint_motor",
            "gripper_motor"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "urdf_joint": {
          "type": [
            "string",
            "null"
          ]
        },
        "extra": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/quantity"
          }
        },
        "part": {
          "$ref": "#/$defs/quantity"
        },
        "revision": {
          "$ref": "#/$defs/quantity"
        },
        "bus": {
          "$ref": "#/$defs/quantity"
        },
        "node_id": {
          "$ref": "#/$defs/quantity"
        },
        "bitrate": {
          "$ref": "#/$defs/quantity"
        },
        "control_mode": {
          "$ref": "#/$defs/quantity"
        },
        "gear_ratio": {
          "$ref": "#/$defs/quantity"
        },
        "rated_speed": {
          "$ref": "#/$defs/quantity"
        },
        "max_speed": {
          "$ref": "#/$defs/quantity"
        },
        "rated_current": {
          "$ref": "#/$defs/quantity"
        },
        "peak_current": {
          "$ref": "#/$defs/quantity"
        },
        "rated_voltage": {
          "$ref": "#/$defs/quantity"
        },
        "supply_bus_voltage_nominal": {
          "$ref": "#/$defs/quantity"
        },
        "supply_bus_voltage_max": {
          "$ref": "#/$defs/quantity"
        },
        "brake_present": {
          "$ref": "#/$defs/quantity"
        },
        "brake_holding_torque": {
          "$ref": "#/$defs/quantity"
        },
        "brake_release_time": {
          "$ref": "#/$defs/quantity"
        },
        "brake_engage_time": {
          "$ref": "#/$defs/quantity"
        },
        "brake_coil_voltage": {
          "$ref": "#/$defs/quantity"
        },
        "rotor_inertia": {
          "$ref": "#/$defs/quantity"
        },
        "joint_damping": {
          "$ref": "#/$defs/quantity"
        },
        "joint_friction": {
          "$ref": "#/$defs/quantity"
        },
        "heartbeat_period": {
          "$ref": "#/$defs/quantity"
        },
        "comm_timeout": {
          "$ref": "#/$defs/quantity"
        },
        "rated_torque": {
          "$ref": "#/$defs/quantity"
        },
        "peak_torque": {
          "$ref": "#/$defs/quantity"
        },
        "rated_force": {
          "$ref": "#/$defs/quantity"
        },
        "peak_force": {
          "$ref": "#/$defs/quantity"
        }
      },
      "oneOf": [
        {
          "required": [
            "rated_torque",
            "peak_torque"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "rated_force"
                ]
              },
              {
                "required": [
                  "peak_force"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "rated_force",
            "peak_force"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "rated_torque"
                ]
              },
              {
                "required": [
                  "peak_torque"
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
