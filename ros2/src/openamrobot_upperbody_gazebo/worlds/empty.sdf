<?xml version="1.0"?>
<!-- SPDX-License-Identifier: MIT -->
<!--
  An empty world for the combined OpenAMRobot 2.0 model: a ground plane, a sun, and the four world systems the model
  needs. Nothing else. Simulation bringup (ADR-003) lives here, not in the description: the model carries its own
  gz_ros2_control and DiffDrive plugins, and this world only has to run them.

    Physics        steps the world (DART, the Harmonic default)
    UserCommands   lets ros_gz_sim `create` add the model
    SceneBroadcaster  the GUI's view of the scene
    Sensors        the base camera and lidar of platform-sw (ogre2); the model is not usable for navigation without it

  Steps of 1/1500 s (0.00066667 s) at real time factor 1. platform-sw's walled_world.sdf steps at 1 ms; this world steps finer so
  that the arm controllers really run at the upstream rate. gz_ros2_control updates the controllers on the first physics step at
  which one controller period has passed. The simulation asks for 750 Hz (openamrobot_upperbody_control config/sim_overlay.yaml),
  a period of 1.333333 ms: with 1 ms steps that is every second step, 500 Hz by the arithmetic (499.5 Hz measured), and with this step
  it is every second step of 0.66667 ms, 750 Hz by the arithmetic (743.6 Hz measured by message count, most common interval 1.333 ms). The step is written a hair above 1/1500 s so that two steps are never short of the period
  after rounding to nanoseconds. test_sim_control_rate.py holds the arithmetic. A world with 1 ms steps still works; its arm
  controllers then update at 500 Hz.
-->
<sdf version="1.6">
  <world name="empty">
    <physics name="1500hz" type="ignored">
      <max_step_size>0.00066667</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
